# Local development values only. Do not use these credentials in production.
# If any POSTGRES_* value changes, update DATABASE_URL below to match it.
# DATABASE_URL uses localhost and POSTGRES_PORT because the backend runs on the host.
POSTGRES_DB=gmc_feed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Runtime and Alembic migration URL. Alembic CLI migrations are explicit; the
# backend never creates tables at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gmc_feed

# NON-PRODUCTION-ONLY placeholder. Replace before any deployed use.
SESSION_SECRET=NON_PRODUCTION_CHANGE_ME
INITIAL_USERNAME=admin
INITIAL_PASSWORD=NON_PRODUCTION_CHANGE_ME
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# M0 requires one backend worker because sessions are held in process memory.

# Production: set to your public URL (https://gmc.example.com)
# PUBLIC_BASE_URL=https://gmc.example.com

# Optional: enable the redis AI cache backend (leave unset for local/disk).
# Either a single REDIS_URL, or the discrete REDIS_* vars (REDIS_URL wins).
# REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# AI_CACHE_DIR=
